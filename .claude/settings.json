{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"if(process.env.CLAUDE_CODE_REMOTE==='true')process.stdout.write(require('fs').readFileSync(require('path').join(process.env.CLAUDE_PROJECT_DIR||'.','.claude','云端通用.md'),'utf8'))\""
          }
        ]
      }
    ]
  }
}
